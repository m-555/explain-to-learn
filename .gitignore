# Training and logging artefacts (adapters go to the Hugging Face Hub)
outputs/
checkpoints/
adapters/
wandb/
mlruns/

# Local app state (may hold learner text from the demo or annotation app)
.gradio/
flagged/

# LaTeX build files; the report PDF is attached to releases, not committed
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
report/*.synctex.gz
report/*.pdf

